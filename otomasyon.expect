#!/usr/bin/expect -f

set timeout -1

# Programı başlatıyoruz
spawn bash zphisher.sh

# 25 saniye bekle
sleep 25

# 2 ye bas
send "2"

# 0,5 saniye bekle
sleep 0.5

# entera bas
send "\r"

# 0,5 saniye bekle
sleep 0.5

# 1 e bas
send "1"

# 0,5 saniye bekle
sleep 0.5

# entera bas
send "\r"

# 0,5 saniye bekle
sleep 0.5

# 1 e bas
send "1"

# 0,5 saniye bekle (Enter öncesi güvenli bekleme)
sleep 0.5

# entera bas
send "\r"

# 2 saniye bekle (Son komutun sisteme oturması için)
sleep 2

# Kontrolü tamamen programa devret ve açık tut
interact
