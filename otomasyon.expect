#!/usr/bin/expect -f

set timeout -1

# Gerçek dosya adınız olan zphisher.sh ile başlatıyoruz
spawn bash zphisher.sh

# Başlangıç için 25 saniye bekle
sleep 25

# 2'ye bas ve enter yap
send "2"
sleep 0.5
send "\r"
sleep 0.5

# 1'e bas ve enter yap
send "1"
sleep 0.5
send "\r"
sleep 0.5

# 1'e bas ve enter yap
send "1"
sleep 0.5
send "\r"

# Sonraki aşama için 5 saniye bekle
sleep 5

# n'ye bas ve enter yap
send "n"
sleep 1
send "\r"
sleep 2

# Kontrolü devret
interact
