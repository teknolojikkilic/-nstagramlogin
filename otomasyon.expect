#!/usr/bin/expect -f

# Zaman aşımı süresini sınırsız yapıyoruz
set timeout -1

# Otomatize edilecek ana betiği başlatıyoruz
spawn bash betik_adi.sh

# 1. Aşama: Başlangıç yüklemesi için 25 saniye bekle
sleep 59

# 2 ye bas ve 0.5 saniye sonra Enter'a bas
send "2"
sleep 0.5
send "\r"
sleep 0.5

# 2. Aşama: 1 e bas ve 0.5 saniye sonra Enter'a bas
send "1"
sleep 0.5
send "\r"
sleep 0.5

# 3. Aşama: Tekrar 1 e bas ve 0.5 saniye sonra Enter'a bas
send "1"
sleep 0.5
send "\r"

# 4. Aşama: İşlemlerin tamamlanması için 5 saniye bekle
sleep 5

# 'n' harfine bas ve 1 saniye sonra son kez Enter'a bas
send "n"
sleep 1
send "\r"
sleep 2

# Tüm otomasyon adımları bittikten sonra sürecin kapanmaması, 
# arka planda çalışmaya devam etmesi için kontrolü sisteme devret
interact
