#!/usr/bin/expect -f

# Bekleme sürelerinin sınırını (saniye cinsinden) tanımlıyoruz
set timeout -1

# Ana script'i başlatıyoruz
spawn ./zphisher.sh

# 1. Seçim: Ekran hareket edene veya ilk girdi alanı gelene kadar bekler. 
# Buradaki "" işaretini boş bırakırsak her satır geçişini bekler.
expect ""
sleep 2
send "2\r"

# 2. Seçim: Bir sonraki adımı bekler ve 1 gönderir
expect ""
sleep 2
send "1\r"

# 3. Seçim: Son adımı bekler ve 1 gönderir
expect ""
sleep 2
send "1\r"

# Seçimler bittikten sonra script'in kapanmaması ve çalışmaya devam etmesi için kontrolü devralır
interact
